{
  "name": "energypro-gestao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EnergyPRO — gestão comercial (CRM, propostas, contratos) sobre o mesmo login do cadastro público",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/montar-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ef": "esbuild supabase/functions/gerar-documento-pdf/src/entrada.mjs --bundle --format=esm --minify --external:pdf-lib --outfile=supabase/functions/gerar-documento-pdf/layout.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
